---
/**
 * /danke. Landeseite nach dem Absenden des Formulars.
 *
 * Steht auf noindex: Sie gehört niemandem in den Suchergebnissen, und ohne
 * abgeschickte Anfrage ergibt sie keinen Sinn.
 */
import Basis from "../layouts/Basis.astro";
import { brand } from "../config/brand";
import { antwortzeit } from "../config/formular";
import { ablauf } from "../data/ablauf";

/**
 * Was der Besucher schon zusammensuchen kann, während er wartet. Kommt aus
 * Schritt 3 des Ablaufs, damit hier keine zweite Liste gepflegt werden muss.
 */
const material = ablauf.find((s) => s.nummer === 3)?.vonDir ?? "";
---

<Basis
  titel="Danke für deine Anfrage"
  beschreibung="Deine Anfrage ist angekommen."
  noindex={true}
>
  <section class="abschnitt">
    <div class="breite">
      <h1>Angekommen.</h1>
      {/* Die Sekunde nach dem Absenden ist der Punkt der größten
          Unsicherheit: Ist das angekommen, wann meldet der sich. Ohne
          Zeitangabe fragt der Besucher parallel bei zwei anderen an. Die
          Zahl steht in config/formular.ts. */}
      <p class="vorspann">
        Deine Anfrage liegt bei mir im Postfach. Ich melde mich {antwortzeit}
        bei dir.
      </p>
      <p>
        Wenn es eilt oder dir noch etwas eingefallen ist, ruf einfach an. Ich
        bin {brand.inhaber}, und am Telefon geht vieles schneller als per Mail.
      </p>
      <p>
        <a class="knopf" href={`tel:${brand.telefonE164}`}>
          {brand.telefonAnzeige}
        </a>
      </p>
    </div>
  </section>

  <section class="abschnitt band--tinte">
    <div class="breite">
      {/* Vorher standen hier drei Verweise, die alle zurück ins Lesen
          führten. Der bessere nächste Schritt nach einer abgeschickten
          Anfrage ist Vorbereitung: Sie nutzt die Wartezeit und verkürzt
          später genau den Schritt, an dem es sonst hängt. */}
      <h2>Wenn du schon anfangen willst</h2>
      <p class="vorspann">
        An diesem einen Punkt hängen die meisten Projekte, und er liegt bei
        dir. Wer das schon beisammen hat, ist ein paar Tage schneller fertig.
      </p>
      <p class="material">{material}.</p>
      <p>
        Ausformulieren musst du nichts. Fotos vom Handy sind völlig in
        Ordnung, solange sie nicht zu dunkel sind.
      </p>
      <ul class="weiter">
        <li>
          <a href="/ablauf">Der ganze Ablauf</a>, sechs Schritte von der
          Anfrage bis online.
        </li>
        <li>
          <a href="/faq">Häufige Fragen</a>. Preise, Dauer, Domain, Pflege.
        </li>
      </ul>
    </div>
  </section>
</Basis>

<style>
  .material {
    max-width: 34rem;
    padding: var(--raum-3);
    border-left: 3px solid var(--auf-tinte);
    background: color-mix(in srgb, var(--karte) 8%, var(--tinte));
    font-family: var(--schrift-titel);
    font-size: var(--gr-h3);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .weiter {
    display: grid;
    gap: var(--raum-2);
    margin: var(--raum-4) 0 0;
    padding: 0;
    list-style: none;
  }
</style>
