---
/**
 * /ueber-mich
 *
 * ACHTUNG: Diese Seite handelt von Tom. Alles, was ich nicht aus seinen
 * Vorgaben ableiten kann, steht als erkennbarer Platzhalter da. Werdegang,
 * Beweggrund, Foto. Ich erfinde hier nichts.
 *
 * Die Region wird laut Vorgabe auf genau einer Seite abgedeckt (/branchen).
 * Deshalb steht hier nur der Kreisname aus brand.ts, keine Städteliste.
 */
import Basis from "../layouts/Basis.astro";
import Kontaktabschluss from "../components/Kontaktabschluss.astro";
import { brand } from "../config/brand";

/** Wie ich arbeite, das ergibt sich aus den Projektregeln, nicht erfunden. */
const arbeitsweise = [
  {
    titel: "Du redest mit mir, nicht mit einem Team",
    text: "Kein Projektleiter, kein Ticketsystem, keine Weiterleitung. Wer den Hörer abnimmt, hat auch die Seite gebaut.",
  },
  {
    titel: "Ich frage nach, statt zu raten",
    text: "Bevor ich anfange, will ich wissen, wer bei dir anruft und was diese Leute vorher wissen müssen. Erst danach entsteht die Seite.",
  },
  {
    titel: "Ich rede so, dass du es verstehst",
    text: "Du bist Gastronom oder Handwerker, kein Techniker. Fachbegriffe erkläre ich im selben Satz oder lasse sie weg.",
  },
  {
    titel: "Der Preis steht vorher fest",
    text: "Was auf der Preisseite steht, zahlst du. Keine Nachträge, weil etwas länger gedauert hat.",
  },
];

/** Was ich nicht mache, auch das steht so in den Projektregeln. */
const nichtMeinGeschaeft = [
  "Keine Agenturen und keine Konzerne. Kleine Betriebe, bei denen der Inhaber selbst am Telefon ist.",
  "Keine Onlineshops. Das ist ein anderes Handwerk und ein anderer Preis.",
  "Kein Redaktionssystem, das du selbst bedienst. Das macht Seiten langsam und angreifbar.",
  "Keine erfundenen Kundenstimmen und keine ausgedachten Erfolgszahlen. Was ich zeige, ist als das gekennzeichnet, was es ist.",
];
---

<Basis
  titel="Über mich"
  beschreibung="Ich arbeite allein, baue Websites für kleine Betriebe und rede so, dass man mich versteht. Wer den Hörer abnimmt, hat auch die Seite gebaut."
>
  <section class="abschnitt">
    <div class="breite">
      <h1>Wer ich bin</h1>
      <p class="vorspann">
        Ich arbeite allein und baue Websites für kleine Betriebe im
        {brand.region}. Meine Nummer steht auf jeder Seite, und da gehe ich
        auch wirklich ran.
      </p>
      <p>
        <a class="knopf" href={`tel:${brand.telefonE164}`}>
          {brand.telefonAnzeige}
        </a>
      </p>
    </div>
  </section>

  <section class="abschnitt band--karte">
    <div class="breite">
      <h2>Wie ich arbeite</h2>
      <ul class="punkte">
        {
          arbeitsweise.map((p) => (
            <li class="punkt">
              <h3>{p.titel}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="abschnitt">
    <div class="breite">
      <h2>Wie ich dazu gekommen bin</h2>
      <div class="platzhalter">
        <p class="platzhalter__marke">Platzhalter: Text fehlt noch</p>
        <p>
          Hier gehören drei bis fünf Sätze hin, die nur Tom schreiben kann:
          seit wann er Websites baut, was er vorher gemacht hat, und warum
          ausgerechnet kleine Betriebe. Der Absatz wird auf dieser Seite am
          meisten gelesen, erfinden lasse ich ihn nicht.
        </p>
        <p class="leise">
          Dazu fehlt noch ein Foto von Tom. Kein Bild aus einer Bilddatenbank,
          kein Bild von jemand anderem am Schreibtisch.
        </p>
      </div>
    </div>
  </section>

  <section class="abschnitt band--tinte">
    <div class="breite">
      <h2>Was ich nicht mache</h2>
      <p class="vorspann">
        Genauso wichtig wie das, was ich anbiete. Wenn du eines davon brauchst,
        sage ich dir das gleich am Telefon, statt dir etwas zu verkaufen.
      </p>
      <ul class="liste">
        {nichtMeinGeschaeft.map((z) => <li>{z}</li>)}
      </ul>
    </div>
  </section>

  <Kontaktabschluss />
</Basis>

<style>
  .punkte {
    display: grid;
    gap: var(--raum-4);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: none;
  }

  .punkt {
    padding-left: var(--raum-3);
    border-left: 3px solid var(--eisblau);
  }

  .punkt h3 {
    margin-bottom: var(--raum-1);
  }

  .punkt p {
    margin: 0;
  }

  .platzhalter {
    max-width: 44rem;
    padding: var(--raum-3);
    border: 2px dashed var(--stahl);
    border-radius: var(--radius);
    background: var(--karte);
  }

  .platzhalter__marke {
    margin: 0 0 var(--raum-2);
    font-size: var(--gr-klein);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--stahl);
  }

  .platzhalter p:last-child {
    margin-bottom: 0;
  }

  .liste {
    display: grid;
    gap: var(--raum-2);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 44rem;
  }

  .liste li {
    position: relative;
    padding-left: 1.375rem;
  }

  .liste li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 0.75rem;
    height: 2px;
    background: var(--auf-tinte-leise);
  }

  @media (min-width: 48em) {
    .punkte {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
