---
/**
 * Die Startseite.
 *
 * Hauptziel: Anfrage. Nächster Schritt: Preise ansehen oder anrufen.
 *
 * Rhythmus: Kreide, dunkel, Kreide, weiß, Kreide, weiß, Kreide, dunkel.
 * Das erste dunkle Band sitzt bewusst auf „Woran es fast immer hängt", also
 * bei Bildschirm 2 und nicht erst bei 11. Vorher lag der einzige dunkle
 * Abschnitt ganz unten, und die Startseite war elf Bildschirme lang ohne ein
 * einziges optisches Ereignis. Dunkel steht für das Problem, hell für die
 * Lösung, deshalb liegt es genau hier und nicht auf dem Fahrplan.
 *
 * Branchen, Leistungen, Pakete und Projekte kommen aus den Datendateien.
 * Trägst du dort etwas ein, steht es hier.
 */
import Basis from "../layouts/Basis.astro";
import Kontaktabschluss from "../components/Kontaktabschluss.astro";
import { brand } from "../config/brand";
import { branchen } from "../data/branchen";
import { probleme } from "../data/probleme";
import { leistungen } from "../data/leistungen";
import { pakete, euro, umsatzsteuerHinweis } from "../data/pakete";
import {
  projekte,
  hinweisKonzeptprojekteKurz,
  zeigeKonzepthinweis,
  kennzeichnung,
} from "../data/projekte";


---

<Basis
  titel="Websites für kleine Betriebe"
  beschreibung="Ich baue Websites für kleine Betriebe im Rhein-Neckar-Kreis: Gastronomie, Handwerk, Studios, Läden. Grundgerüst in 24 bis 72 Stunden."
>
  <section class="abschnitt">
    <div class="breite">
      <h1>Du machst gute Arbeit. Nur findet sie online keiner.</h1>
      <p class="vorspann">
        Ich bin {brand.inhaber} und baue Websites für kleine Betriebe im
        {" "}{brand.region}. Das Grundgerüst steht in 24 bis 72 Stunden.
      </p>
      <p class="knoepfe">
        <a class="knopf" href="/preise">Preise ansehen</a>
        <a class="knopf knopf--rand" href="/kontakt">Anfrage schicken</a>
      </p>

      {/* Der Kanal, den ich selbst als schnellsten bezeichne, stand hier
          vorher als kleinstes und grauestes Element der Seite: 14 Pixel in
          .leise, unter zwei Knöpfen. Für einen Handwerksbetrieb ist der
          Anruf nicht die dritte Möglichkeit, sondern die erste. */}
      <p class="anruf">
        <a class="anruf__verweis" href={`tel:${brand.telefonE164}`}>
          <svg
            class="anruf__hoerer"
            viewBox="0 0 16 16"
            width="17"
            height="17"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M4.2 1.6 6 4.1 4.5 5.9c.9 1.9 2.4 3.4 4.3 4.3l1.8-1.5 2.5 1.8c.3.9-.4 2.4-1.7 2.9C8.5 14.2 1.8 7.5 2.4 3.3c.5-1.3 2-2 2.9-1.7Z"
              fill="currentColor"></path>
          </svg>
          {brand.telefonAnzeige}
        </a>
        <span class="anruf__zusatz">
          Ruf einfach an, das geht am schnellsten.
        </span>
      </p>
    </div>
  </section>

  <section class="abschnitt band--tinte">
    <div class="breite">
      <h2>Woran es fast immer hängt</h2>
      <p class="vorspann">
        Drei Dinge kosten dich Anrufe, bevor überhaupt einer entsteht. Keines
        davon ist eine Geschmacksfrage.
      </p>
      <ul class="kacheln kacheln--3">
        {
          probleme.map((p) => (
            <li class="kachel">
              <h3>{p.titel}</h3>
              <p>{p.kurz}</p>
              <a class="kachel__mehr" href={`/probleme/${p.slug}`}>
                Mehr erfahren
                <span class="nur-vorlesen"> über: {p.titel}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="fazit">
        Wer eines davon erlebt, sucht weiter. Nicht weil dein Laden schlecht
        wäre, sondern weil er es gar nicht erst herausfindet.
      </p>
    </div>
  </section>

  {/* Der Fingertest. Er stand zwei Klicks tief auf /probleme/preise-im-pdf,
      und er ist das stärkste Stück Inhalt der ganzen Website: Der Besucher
      stellt die Diagnose selbst, an seinem eigenen Betrieb, in zehn
      Sekunden. Das ist kein Argument, das er glauben muss, sondern ein
      Befund, den er selbst erhebt. */}
  <section class="abschnitt band--karte">
    <div class="breite">
      <h2>Der Fingertest, jetzt gleich, dauert zehn Sekunden</h2>
      <p class="vorspann">
        Öffne deine Speisekarte oder deine Preisliste auf dem Handy. Versuch,
        ein einzelnes Wort mit dem Finger zu markieren.
      </p>
      <p class="fazit">
        Geht nicht? Dann ist es ein Bild. Google liest es nicht, und dein Gast
        muss hineinzoomen.
      </p>
      <p class="knoepfe">
        <a class="knopf" href="/probleme/preise-im-pdf">
          Was das konkret kostet
        </a>
      </p>
    </div>
  </section>

  <section class="abschnitt">
    <div class="breite">
      <h2>Vom Anruf bis deine Seite steht</h2>
      <p class="vorspann">
        Drei Schritte, und einer davon liegt bei dir. Ein bis drei Tage nach
        deinem Material machst du deine Seite auf deinem eigenen Handy auf.
      </p>

      <div class="fahrplan">
        <ol class="zeitplan">
          <li class="halt">
            <span class="halt__marke" aria-hidden="true">1</span>
            <span class="halt__dauer">20 Minuten</span>
            <h3 class="halt__titel">Das Telefonat</h3>
            <p class="halt__text">
              Ich frage, wer bei dir anruft, bestellt oder bucht und was diese
              Leute vorher wissen müssen. Danach kennst du deinen Preis.
            </p>
          </li>

          <li class="halt halt--offen">
            <span class="halt__marke halt__marke--offen" aria-hidden="true"
              >2</span
            >
            <span class="halt__dauer halt__dauer--offen">Liegt bei dir</span>
            <h3 class="halt__titel">Dein Material</h3>
            <p class="halt__text">
              Texte oder Stichpunkte, Fotos, Öffnungszeiten, Preise, die
              Angaben fürs Impressum. Stichpunkte reichen, die Sätze baue ich
              daraus. Sind sie am Montag da, steht die Seite am Mittwoch.
            </p>
          </li>

          <li class="halt">
            <span class="halt__marke" aria-hidden="true">3</span>
            <span class="halt__dauer">24 bis 72 Stunden</span>
            <h3 class="halt__titel">Deine Seite steht</h3>
            <p class="halt__text">
              Du bekommst eine Adresse aufs Handy, gehst alles in Ruhe durch
              und sagst mir, was geändert wird.
            </p>
          </li>
        </ol>

        <figure class="vorschau">
          <div class="handy" aria-hidden="true">
            <div class="handy__leiste">
              <svg
                class="handy__schloss"
                viewBox="0 0 12 14"
                width="9"
                height="11"
                focusable="false"
              >
                <path
                  d="M3.25 6V4a2.75 2.75 0 0 1 5.5 0v2"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"></path>
                <rect x="1" y="6" width="10" height="7" rx="1"></rect>
              </svg>
              vorschau.deinbetrieb.de
            </div>

            <div class="handy__kopf">
              <span class="handy__marke"></span>
              <span class="handy__menue">
                <span></span><span></span><span></span>
              </span>
            </div>

            <div class="handy__inhalt">
              <span class="bl bl--titel"></span>
              <span class="bl bl--titel bl--kurz"></span>
              <span class="bl"></span>
              <span class="bl bl--kurz"></span>
              <span class="handy__knopf">Jetzt anrufen</span>
              <span class="handy__zeiten">
                <span class="handy__zeit"><span>Mo bis Fr</span><span
                    >11 bis 22 Uhr</span
                  ></span>
                <span class="handy__zeit"><span>Samstag</span><span
                    >12 bis 23 Uhr</span
                  ></span>
                <span class="handy__zeit"><span>Sonntag</span><span
                    >Ruhetag</span
                  ></span>
              </span>
            </div>
          </div>

          <figcaption>
            Keine Vorschau als Bild, das du abnicken sollst. Eine echte
            Adresse, die du aufmachen und weiterschicken kannst.
          </figcaption>
        </figure>
      </div>

      <p>
        <a href="/ablauf">Der ganze Ablauf, Schritt für Schritt</a>
      </p>
    </div>
  </section>

  <section class="abschnitt band--karte">
    <div class="breite">
      <h2>Fünf Branchen, die ich am besten kenne</h2>
      <p class="vorspann">
        Diese fünf fragen am häufigsten an, deshalb haben sie eine eigene
        Seite. Gebaut wird für jeden Einzelbetrieb.
      </p>
      {/* Bewusst eine Reihe und kein Raster. Die Startseite trug vorher vier
          Kachelraster hintereinander mit fünfzehn optisch gleichen Karten,
          und dieser Abschnitt allein war 2,7 Bildschirme hoch. Die
          Beschreibung je Branche steht dort, wo sie hingehört: auf der
          Branchenseite. */}
      <ul class="branchenreihe">
        {
          branchen.map((b) => (
            <li>
              <a href={`/branchen/${b.slug}`}>{b.name}</a>
            </li>
          ))
        }
        <li>
          <a class="offen-chip" href="/kontakt">Andere Branche</a>
        </li>
      </ul>

      {/* Der stärkste Satz der ganzen Website, und deshalb steht er genau
          einmal, groß, und nicht viermal in Absatzgröße verteilt. Was hier
          vorher an Aufzählung stand, macht jetzt die sechste Kachel. */}
      <div class="zuschnitt">
        <p class="zuschnitt__satz">
          Ein Standort, ein Inhaber, jemand, der selbst ans Telefon geht.
        </p>
        <p class="zuschnitt__nein">
          <strong>Was ich nicht baue:</strong> Onlineshops, Auftritte für
          Konzerne, Zulieferarbeit für Agenturen. Bei Ketten mit mehreren
          Filialen entscheidet die Zentrale, und da bin ich der Falsche.
        </p>
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="breite">
      <h2>Was ich mache</h2>
      <ul class="kacheln kacheln--3">
        {
          leistungen.map((l) => (
            <li class="kachel">
              <h3>{l.name}</h3>
              <p>{l.kurz}</p>
              <a class="kachel__mehr" href={`/leistungen/${l.slug}`}>
                Mehr dazu
                <span class="nur-vorlesen"> zu: {l.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="abschnitt band--karte">
    <div class="breite">
      <h2>Preise, die vorher feststehen</h2>
      <p class="vorspann">
        Drei Pakete, und der Preis hängt allein an der Seitenzahl. Auf der
        Preisseite siehst du deinen Betrag sofort.
      </p>

      <ul class="preise">
        {
          pakete.map((p) => (
            <li class:list={["preis", p.hervorgehoben && "preis--wahl"]}>
              <span class="preis__name">{p.name}</span>
              <span class="preis__betrag">ab {euro(p.preisAb)}</span>
              <span class="preis__zusatz">
                {p.seitenMin}–{p.seitenMax} Seiten · {euro(p.pflegeMonat)} im
                Monat
              </span>
            </li>
          ))
        }
      </ul>

      <p class="leise">{umsatzsteuerHinweis}. Der angezeigte Preis ist der Preis.</p>
      <p>
        <a class="knopf" href="/preise">Preise vergleichen</a>
      </p>
    </div>
  </section>

  <section class="abschnitt">
    <div class="breite">
      <h2>Drei Betriebe, drei durchgeplante Websites</h2>

      <ul class="kacheln kacheln--3">
        {
          projekte.map((p) => (
            <li class="kachel">
              {kennzeichnung(p) && (
                <p class="kachel__marke">{kennzeichnung(p)}</p>
              )}
              <h3>{p.name}</h3>
              <p>{p.kurz}</p>
              <a class="kachel__mehr" href={`/arbeiten/${p.slug}`}>
                Projekt ansehen
                <span class="nur-vorlesen">: {p.name}</span>
              </a>
            </li>
          ))
        }
      </ul>

      {/* Steht bewusst unter den Karten. Wer zuerst die Entschuldigung liest,
          sieht die Arbeit danach mit anderen Augen. */}
      {zeigeKonzepthinweis && <p class="nachsatz">{hinweisKonzeptprojekteKurz}</p>}
    </div>
  </section>

  <Kontaktabschluss />
</Basis>

<style>
  .knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: var(--raum-2);
    margin-bottom: var(--raum-3);
  }

  /* Anruf im Kopf der Startseite ---------------------------------------- */

  .anruf {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem var(--raum-2);
    margin-bottom: 0;
  }

  .anruf__verweis {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--schrift-titel);
    font-size: var(--gr-h3);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .anruf__verweis:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .anruf__hoerer {
    flex: none;
  }

  .anruf__zusatz {
    color: color-mix(in srgb, var(--tinte) 75%, var(--papier));
  }

  /* Fahrplan ------------------------------------------------------------- */
  /* Vorher stand hier eine Aufzählung mit Randlinie, also Fließtext in drei
     Teilen. Jetzt eine Schiene mit nummerierten Halten und daneben das Handy
     mit der Vorschauadresse. Ohne Bewegung: PROJEKT.md verbietet
     Einblende-Animationen beim Scrollen. */

  .fahrplan {
    display: grid;
    gap: var(--raum-4);
    margin: var(--raum-4) 0;
  }

  @media (min-width: 62rem) {
    .fahrplan {
      grid-template-columns: minmax(0, 1fr) 17rem;
      align-items: start;
      gap: var(--raum-6);
    }
  }

  .zeitplan {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 40rem;
  }

  .halt {
    position: relative;
    padding-left: 3.5rem;
    padding-bottom: var(--raum-4);
  }

  .halt:last-child {
    padding-bottom: 0;
  }

  /* Die Schiene zwischen zwei Halten. Beim offenen Schritt gestrichelt,
     weil dort niemand eine Dauer versprechen kann. */
  .halt::before {
    content: "";
    position: absolute;
    left: 1.1875rem;
    top: 2.75rem;
    bottom: 0;
    border-left: 2px solid var(--kante);
  }

  .halt:last-child::before {
    display: none;
  }

  .halt--offen::before {
    border-left-style: dashed;
  }

  .halt__marke {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 2px solid var(--stahl);
    border-radius: var(--radius);
    background: var(--stahl);
    color: var(--auf-tinte);
    font-family: var(--schrift-titel);
    font-size: 1.25rem;
    font-weight: 600;
  }

  /* Der Schritt, der bei Tom nicht liegt, ist auch optisch nicht gefüllt. */
  .halt__marke--offen {
    background: transparent;
    color: var(--stahl);
  }

  /* "24 bis 72 Stunden" ist das stärkste Verkaufsargument der Seite. Es stand
     in der Größe einer Bildunterschrift über der Überschrift. */
  .halt__dauer {
    display: block;
    margin-bottom: 0.125rem;
    font-size: var(--gr-text);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--stahl);
  }

  .halt__dauer--offen {
    color: color-mix(in srgb, var(--tinte) 65%, var(--papier));
  }

  .halt__titel {
    margin: 0 0 var(--raum-1);
  }

  .halt__text {
    margin: 0;
    color: color-mix(in srgb, var(--tinte) 82%, var(--papier));
  }

  /* Handy ---------------------------------------------------------------- */
  /* Schematisch, kein Bildschirmfoto: Balken statt Text, damit niemand ein
     Kundenprojekt hineinliest. Die Maße darin sind kleiner als --raum-1 und
     stehen deshalb bewusst als eigene, kleine Staffel hier unten. */

  /* Am Telefon steht das Handy neben seiner Bildunterschrift. Untereinander
     kostet es dort 300 Pixel, und die Startseite liegt ohnehin nah an der
     Vellox-Grenze von zwölf Bildschirmen. */
  .vorschau {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    align-items: center;
    gap: var(--raum-3);
    margin: 0;
  }

  @media (min-width: 62rem) {
    .vorschau {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: var(--raum-2);
    }
  }

  .handy {
    --geraet: 1.25rem; /* Geräteecken, runder als --radius. Ein Handy hat keine 4-px-Ecken. */
    display: flex;
    flex-direction: column;
    aspect-ratio: 10 / 19;
    max-width: 15rem;
    border: 0.375rem solid var(--tinte);
    border-radius: var(--geraet);
    background: var(--karte);
    overflow: hidden;
  }

  @media (min-width: 62rem) {
    .handy {
      border-width: 0.5rem;
    }
  }

  .handy__leiste {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.375rem 0.25rem;
    background: var(--papier);
    border-bottom: 1px solid var(--eisblau);
    font-size: 0.5rem;
    white-space: nowrap;
    color: color-mix(in srgb, var(--tinte) 70%, var(--papier));
  }

  @media (min-width: 62rem) {
    .handy__leiste {
      font-size: 0.5625rem;
    }
  }

  .handy__schloss {
    flex: none;
    fill: currentColor;
  }

  .handy__kopf {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.625rem;
    background: var(--tinte);
  }

  .handy__marke {
    width: 2.5rem;
    height: 0.375rem;
    background: var(--auf-tinte);
  }

  .handy__menue {
    display: grid;
    gap: 0.1875rem;
  }

  .handy__menue span {
    display: block;
    width: 0.75rem;
    height: 0.125rem;
    background: var(--auf-tinte);
  }

  .handy__inhalt {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    flex: 1;
    padding: 0.75rem 0.625rem;
  }

  .bl {
    display: block;
    height: 0.375rem;
    background: var(--eisblau);
  }

  .bl--titel {
    height: 0.6875rem;
    background: color-mix(in srgb, var(--tinte) 55%, var(--karte));
  }

  .bl--kurz {
    width: 65%;
  }

  .handy__knopf {
    display: block;
    margin-top: 0.375rem;
    padding: 0.375rem;
    border-radius: var(--radius);
    background: var(--stahl);
    color: var(--auf-tinte);
    font-family: var(--schrift-titel);
    font-size: 0.5625rem;
    font-weight: 600;
    text-align: center;
  }

  .handy__zeiten {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.375rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--eisblau);
    font-size: 0.5rem;
  }

  .handy__zeit {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    color: color-mix(in srgb, var(--tinte) 75%, var(--karte));
  }

  .vorschau figcaption {
    max-width: 24rem;
    margin: 0;
    font-size: var(--gr-klein);
    color: color-mix(in srgb, var(--tinte) 75%, var(--papier));
  }

  /* Zuschnitt ------------------------------------------------------------ */
  /* Wofür ich nicht der Richtige bin. Vellox: Jede Seite, die verkauft, sagt
     an mindestens einer Stelle, für wen sie nicht gemacht ist.

     Der Block klebte bündig unter den Kacheln und ging darin unter. Kein
     zweiter Kasten, darüber stehen schon fünf. Stattdessen Luft, eine
     kräftige Linie und eine eigene Überschrift. */

  /* Kein zweiter Kasten: Die Kacheln darüber sind weiß mit Rahmen, dieser
     Block ist kreidefarben ohne Rahmen und mit kantigen Ecken. Dadurch
     liest er sich als eigene Aussage und nicht als sechste Kachel. */
  .zuschnitt {
    max-width: 46rem;
    margin-top: var(--raum-6);
    padding: var(--raum-4);
    border-top: 3px solid var(--stahl);
    background: var(--papier);
  }

  @media (min-width: 48em) {
    .zuschnitt {
      padding: var(--raum-5);
    }
  }

  /* Die laute Stelle des Abschnitts. Auf einer Seite, auf der sonst alles
     zwischen 14 und 24 Pixeln liegt, ist ein Satz in Überschriftengröße das
     Ereignis. Ohne so eine Stelle liest sich Zurückhaltung als Langeweile. */
  .zuschnitt__satz {
    max-width: 24ch;
    margin-bottom: var(--raum-3);
    font-family: var(--schrift-titel);
    font-size: var(--gr-h2);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .zuschnitt p {
    margin-bottom: var(--raum-3);
    max-width: var(--breite-text);
  }

  .zuschnitt p:last-child {
    margin-bottom: 0;
  }

  .zuschnitt__nein {
    color: color-mix(in srgb, var(--tinte) 78%, var(--papier));
  }

  /* Fazit ---------------------------------------------------------------- */

  .fazit {
    margin-top: var(--raum-4);
    margin-bottom: 0;
    font-size: var(--gr-gross);
    font-weight: 600;
  }

  .nachsatz {
    margin-top: var(--raum-3);
    margin-bottom: 0;
    color: color-mix(in srgb, var(--tinte) 80%, var(--papier));
  }

  /* Preisübersicht: knapp, die eigentliche Tabelle steht auf /preise. */
