---
/**
 * Die Startseite.
 *
 * Hauptziel: Anfrage. Nächster Schritt: Preise ansehen oder anrufen.
 * Aufbau nach dem Hell-Dunkel-Rhythmus, die beiden Tinte-Bänder sitzen beim
 * 24–72-Stunden-Abschnitt und beim Abschluss.
 *
 * Branchen, Leistungen, Pakete und Projekte kommen aus den Datendateien.
 * Trägst du dort etwas ein, steht es hier.
 */
import Basis from "../layouts/Basis.astro";
import Kontaktabschluss from "../components/Kontaktabschluss.astro";
import { brand } from "../config/brand";
import { branchen } from "../data/branchen";
import { leistungen } from "../data/leistungen";
import { pakete, euro, umsatzsteuerHinweis } from "../data/pakete";
import {
  projekte,
  hinweisKonzeptprojekte,
  zeigeKonzepthinweis,
  kennzeichnung,
} from "../data/projekte";

/** Was jemand findet, der einen kleinen Betrieb googelt. Immer dasselbe. */
const befunde = [
  {
    titel: "Die Karte ist ein Foto",
    text: "Google liest keine Bilder. Wer abends nach Pizza in Weinheim sucht, findet dich nicht, auch wenn du seit zwölf Jahren dort kochst.",
  },
  {
    titel: "Die Öffnungszeiten stehen im Impressum",
    text: "Oder bei Google, und dort falsch. Dabei ist es die Frage, die am häufigsten gestellt wird.",
  },
  {
    titel: "Auf dem Handy muss man zoomen",
    text: "Fast alle schauen auf dem Handy. Wer wischen und vergrößern muss, ist nach zehn Sekunden wieder weg.",
  },
];
---

<Basis
  titel="Websites für kleine Betriebe"
  beschreibung="Ich baue Websites für kleine Betriebe im Rhein-Neckar-Kreis: Gastronomie, Handwerk, Studios, Läden. Grundgerüst in 24 bis 72 Stunden."
>
  <section class="abschnitt">
    <div class="breite">
      <h1>Du machst gute Arbeit. Nur findet sie online keiner.</h1>
      <p class="vorspann">
        Ich bin {brand.inhaber} und baue Websites für kleine Betriebe im
        {" "}{brand.region}. Das Grundgerüst steht in 24 bis 72 Stunden.
      </p>
      <p class="knoepfe">
        <a class="knopf" href="/preise">Preise ansehen</a>
        <a class="knopf knopf--rand" href="/kontakt">Anfrage schicken</a>
      </p>
      <p class="leise">
        Oder ruf einfach an:{" "}
        <a href={`tel:${brand.telefonE164}`}>{brand.telefonAnzeige}</a>
      </p>
    </div>
  </section>

  <section class="abschnitt band--karte">
    <div class="breite">
      <h2>Woran es fast immer hängt</h2>
      <p class="vorspann">
        Drei Dinge halten Anrufe auf, bevor sie überhaupt entstehen. Mit
        Geschmack hat keines davon zu tun.
      </p>
      <ul class="kacheln kacheln--3">
        {
          befunde.map((b) => (
            <li class="kachel">
              <h3>{b.titel}</h3>
              <p>{b.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="fazit">
        Das sind keine Geschmacksfragen. Das sind Anrufe, die nicht ankommen.
      </p>
    </div>
  </section>

  <section class="abschnitt band--tinte">
    <div class="breite">
      <h2>In 24 bis 72 Stunden steht dein Grundgerüst</h2>
      <p class="vorspann">
        Sobald deine Texte und Bilder da sind, siehst du deine Seite unter
        einer Vorschauadresse.
      </p>
      <p>
        Nicht als Bild zum Abnicken, sondern als echte Seite, die du auf
        deinem eigenen Handy aufmachen kannst.
      </p>

      <ol class="zeitplan">
        <li>
          <span class="zeitplan__wann">Tag 1, vormittags</span>
          <span class="zeitplan__was">
            Zwanzig Minuten am Telefon. Danach weißt du, was es kostet.
          </span>
        </li>
        <li>
          <span class="zeitplan__wann">Sobald dein Material da ist</span>
          <span class="zeitplan__was">
            Texte oder Stichpunkte, Fotos, Öffnungszeiten. Mehr brauche ich
            nicht zum Anfangen.
          </span>
        </li>
        <li>
          <span class="zeitplan__wann">24 bis 72 Stunden später</span>
          <span class="zeitplan__was">
            Deine Seite steht unter einer Vorschauadresse. Du gehst sie durch,
            ich setze deine Änderungen um.
          </span>
        </li>
      </ol>

      <p>
        Ehrlich gesagt hängt es fast immer an derselben Stelle, und das ist
        nicht das Bauen: Es hängt an deinem Material. Stichpunkte reichen mir,
        die Sätze mache ich daraus.
      </p>
      <p>
        <a href="/ablauf">Der ganze Ablauf, Schritt für Schritt</a>
      </p>
    </div>
  </section>

  <section class="abschnitt">
    <div class="breite">
      <h2>Für wen ich baue</h2>
      <p class="vorspann">
        Diese fünf kenne ich am besten, weil ich sie am häufigsten baue. Sie
        sind keine Grenze.
      </p>
      <ul class="kacheln kacheln--5">
        {
          branchen.map((b) => (
            <li class="kachel">
              <h3>{b.name}</h3>
              <p>{b.kurz}</p>
              <a class="kachel__mehr" href={`/branchen/${b.slug}`}>
                Für {b.name} ansehen
              </a>
            </li>
          ))
        }
      </ul>

      <p class="offen">
        <strong>Deine Branche ist nicht dabei?</strong> Macht nichts. Werkstatt,
        Praxis, Fahrschule, Metzgerei, Fotograf, Steuerbüro: Ich baue für jeden
        Betrieb, hinter dem ein Mensch steht, der selbst ans Telefon geht. Die
        Fragen sind überall dieselben, nur die Antworten sind andere.
      </p>

      <p class="abgrenzung">
        <strong>Für wen ich nicht der Richtige bin:</strong> Onlineshops baue
        ich nicht, Konzerne betreue ich nicht, und für Agenturen arbeite ich
        nicht zu. Wenn das auf dich zutrifft, sage ich dir das im ersten
        Telefonat, statt dir etwas zu verkaufen.
      </p>
    </div>
  </section>

  <section class="abschnitt band--karte">
    <div class="breite">
      <h2>Was ich mache</h2>
      <ul class="kacheln kacheln--4">
        {
          leistungen.map((l) => (
            <li class="kachel">
              <h3>{l.name}</h3>
              <p>{l.kurz}</p>
              <a class="kachel__mehr" href={`/leistungen/${l.slug}`}>
                Mehr dazu
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="abschnitt">
    <div class="breite">
      <h2>Preise, die vorher feststehen</h2>
      <p class="vorspann">
        Drei Pakete, und der Preis hängt allein an der Seitenzahl. Auf der
        Preisseite siehst du deinen Betrag sofort.
      </p>

      <ul class="preise">
        {
          pakete.map((p) => (
            <li class:list={["preis", p.hervorgehoben && "preis--wahl"]}>
              <span class="preis__name">{p.name}</span>
              <span class="preis__betrag">ab {euro(p.preisAb)}</span>
              <span class="preis__zusatz">
                {p.seitenMin}–{p.seitenMax} Seiten · {euro(p.pflegeMonat)} im
                Monat
              </span>
            </li>
          ))
        }
      </ul>

      <p class="leise">{umsatzsteuerHinweis}. Der angezeigte Preis ist der Preis.</p>
      <p>
        <a class="knopf" href="/preise">Preise vergleichen</a>
      </p>
    </div>
  </section>

  <section class="abschnitt band--karte">
    <div class="breite">
      <h2>Beispiele</h2>
      {zeigeKonzepthinweis && <p>{hinweisKonzeptprojekte}</p>}

      <ul class="kacheln kacheln--3">
        {
          projekte.map((p) => (
            <li class="kachel">
              {kennzeichnung(p) && (
                <p class="kachel__marke">{kennzeichnung(p)}</p>
              )}
              <h3>{p.name}</h3>
              <p>{p.kurz}</p>
              <a class="kachel__mehr" href={`/arbeiten/${p.slug}`}>
                Projekt ansehen
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Kontaktabschluss />
</Basis>

<style>
  .knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: var(--raum-2);
    margin-bottom: var(--raum-3);
  }

  /* Zeitplan im Tinte-Band. Ohne ihn stand dort nur Fließtext. */
  .zeitplan {
    display: grid;
    gap: var(--raum-3);
    margin: var(--raum-4) 0;
    padding: 0;
    list-style: none;
    max-width: 48rem;
  }

  .zeitplan li {
    display: grid;
    gap: 0.25rem;
    padding-left: var(--raum-3);
    border-left: 3px solid var(--auf-tinte-leise);
  }

  .zeitplan__wann {
    font-family: var(--schrift-titel);
    font-size: var(--gr-h3);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .zeitplan__was {
    color: var(--auf-tinte-leise);
  }

  /* Wofür ich nicht der Richtige bin. Vellox: Jede Seite, die verkauft, sagt
     an mindestens einer Stelle, für wen sie nicht gemacht ist. */
  .abgrenzung {
    margin-top: var(--raum-3);
    padding: var(--raum-3);
    border-left: 3px solid var(--stahl);
    background: var(--karte);
    max-width: 44rem;
  }

  .fazit {
    margin-top: var(--raum-4);
    margin-bottom: 0;
    font-size: var(--gr-gross);
    font-weight: 600;
  }

  /* Preisübersicht: knapp, die eigentliche Tabelle steht auf /preise. */
  .preise {
    display: grid;
    gap: 0;
    margin: 0 0 var(--raum-3);
    padding: 0;
    list-style: none;
    max-width: 44rem;
    border: 2px solid var(--eisblau);
    border-radius: var(--radius);
    background: var(--karte);
  }

  .preis {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 var(--raum-2);
    padding: var(--raum-3);
    border-bottom: 1px solid var(--eisblau);
  }

  .preis:last-child {
    border-bottom: 0;
  }

  .preis--wahl {
    border-left: 4px solid var(--stahl);
  }

  .preis__name {
    font-family: var(--schrift-titel);
    font-size: var(--gr-h3);
    font-weight: 600;
  }

  .preis__betrag {
    font-family: var(--schrift-titel);
    font-size: var(--gr-h3);
    font-weight: 600;
    text-align: right;
  }

  .preis__zusatz {
    grid-column: 1 / -1;
    margin-top: 0.25rem;
    font-size: var(--gr-klein);
    color: color-mix(in srgb, var(--tinte) 70%, var(--karte));
  }
</style>
