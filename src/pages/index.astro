---
/**
 * Die Startseite.
 *
 * Hauptziel: Anfrage. Nächster Schritt: Preise ansehen oder anrufen.
 * Aufbau nach dem Hell-Dunkel-Rhythmus: Kreide und Weiß im Wechsel, dunkel
 * wird nur der Abschluss. Der 24–72-Stunden-Abschnitt war früher ein
 * Tinte-Band, steht seit dem 10.08. auf Kreide.
 *
 * Branchen, Leistungen, Pakete und Projekte kommen aus den Datendateien.
 * Trägst du dort etwas ein, steht es hier.
 */
import Basis from "../layouts/Basis.astro";
import Kontaktabschluss from "../components/Kontaktabschluss.astro";
import { brand } from "../config/brand";
import { branchen } from "../data/branchen";
import { probleme } from "../data/probleme";
import { leistungen } from "../data/leistungen";
import { pakete, euro, umsatzsteuerHinweis } from "../data/pakete";
import {
  projekte,
  hinweisKonzeptprojekte,
  zeigeKonzepthinweis,
  kennzeichnung,
} from "../data/projekte";


---

<Basis
  titel="Websites für kleine Betriebe"
  beschreibung="Ich baue Websites für kleine Betriebe im Rhein-Neckar-Kreis: Gastronomie, Handwerk, Studios, Läden. Grundgerüst in 24 bis 72 Stunden."
>
  <section class="abschnitt">
    <div class="breite">
      <h1>Du machst gute Arbeit. Nur findet sie online keiner.</h1>
      <p class="vorspann">
        Ich bin {brand.inhaber} und baue Websites für kleine Betriebe im
        {" "}{brand.region}. Das Grundgerüst steht in 24 bis 72 Stunden.
      </p>
      <p class="knoepfe">
        <a class="knopf" href="/preise">Preise ansehen</a>
        <a class="knopf knopf--rand" href="/kontakt">Anfrage schicken</a>
      </p>
      <p class="leise">
        Oder ruf einfach an:{" "}
        <a href={`tel:${brand.telefonE164}`}>{brand.telefonAnzeige}</a>
      </p>
    </div>
  </section>

  <section class="abschnitt band--karte">
    <div class="breite">
      <h2>Woran es fast immer hängt</h2>
      <p class="vorspann">
        Drei Dinge kosten dich Anrufe, bevor überhaupt einer entsteht. Keines
        davon ist eine Geschmacksfrage.
      </p>
      <ul class="kacheln kacheln--3">
        {
          probleme.map((p) => (
            <li class="kachel">
              <h3>{p.titel}</h3>
              <p>{p.kurz}</p>
              <a class="kachel__mehr" href={`/probleme/${p.slug}`}>
                Mehr erfahren
              </a>
            </li>
          ))
        }
      </ul>
      <p class="fazit">
        Wer eines davon erlebt, sucht weiter. Nicht weil dein Laden schlecht
        wäre, sondern weil er es gar nicht erst herausfindet.
      </p>
    </div>
  </section>

  <section class="abschnitt">
    <div class="breite">
      <h2>Vom Anruf bis deine Seite steht</h2>
      <p class="vorspann">
        Drei Schritte, und einer davon liegt bei dir. Ein bis drei Tage nach
        deinem Material machst du deine Seite auf deinem eigenen Handy auf.
      </p>

      <div class="fahrplan">
        <ol class="zeitplan">
          <li class="halt">
            <span class="halt__marke" aria-hidden="true">1</span>
            <span class="halt__dauer">20 Minuten</span>
            <h3 class="halt__titel">Das Telefonat</h3>
            <p class="halt__text">
              Ich frage, wer bei dir anruft, bestellt oder bucht und was diese
              Leute vorher wissen müssen. Danach kennst du deinen Preis.
            </p>
          </li>

          <li class="halt halt--offen">
            <span class="halt__marke halt__marke--offen" aria-hidden="true"
              >2</span
            >
            <span class="halt__dauer halt__dauer--offen">Liegt bei dir</span>
            <h3 class="halt__titel">Dein Material</h3>
            <p class="halt__text">
              Texte oder Stichpunkte, Fotos, Öffnungszeiten, Preise, die
              Angaben fürs Impressum. Stichpunkte reichen, die Sätze baue ich
              daraus. Sind sie am Montag da, steht die Seite am Mittwoch.
            </p>
          </li>

          <li class="halt">
            <span class="halt__marke" aria-hidden="true">3</span>
            <span class="halt__dauer">24 bis 72 Stunden</span>
            <h3 class="halt__titel">Deine Seite steht</h3>
            <p class="halt__text">
              Du bekommst eine Adresse aufs Handy, gehst alles in Ruhe durch
              und sagst mir, was geändert wird.
            </p>
          </li>
        </ol>

        <figure class="vorschau">
          <div class="handy" aria-hidden="true">
            <div class="handy__leiste">
              <svg
                class="handy__schloss"
                viewBox="0 0 12 14"
                width="9"
                height="11"
                focusable="false"
              >
                <path
                  d="M3.25 6V4a2.75 2.75 0 0 1 5.5 0v2"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"></path>
                <rect x="1" y="6" width="10" height="7" rx="1"></rect>
              </svg>
              vorschau.deinbetrieb.de
            </div>

            <div class="handy__kopf">
              <span class="handy__marke"></span>
              <span class="handy__menue">
                <span></span><span></span><span></span>
              </span>
            </div>

            <div class="handy__inhalt">
              <span class="bl bl--titel"></span>
              <span class="bl bl--titel bl--kurz"></span>
              <span class="bl"></span>
              <span class="bl bl--kurz"></span>
              <span class="handy__knopf">Jetzt anrufen</span>
              <span class="handy__zeiten">
                <span class="handy__zeit"><span>Mo bis Fr</span><span
                    >11 bis 22 Uhr</span
                  ></span>
                <span class="handy__zeit"><span>Samstag</span><span
                    >12 bis 23 Uhr</span
                  ></span>
                <span class="handy__zeit"><span>Sonntag</span><span
                    >Ruhetag</span
                  ></span>
              </span>
            </div>
          </div>

          <figcaption>
            Keine Vorschau als Bild, das du abnicken sollst. Eine echte
            Adresse, die du aufmachen und weiterschicken kannst.
          </figcaption>
        </figure>
      </div>

      <p>
        <a href="/ablauf">Der ganze Ablauf, Schritt für Schritt</a>
      </p>
    </div>
  </section>

  <section class="abschnitt band--karte">
    <div class="breite">
      <h2>Für wen ich baue</h2>
      <p class="vorspann">
        Ich baue für jede Branche. Diese fünf kenne ich nur am besten, weil
        sie am häufigsten anfragen.
      </p>
      <ul class="kacheln kacheln--5">
        {
          branchen.map((b) => (
            <li class="kachel">
              <h3>{b.name}</h3>
              <p>{b.kurz}</p>
              <a class="kachel__mehr" href={`/branchen/${b.slug}`}>
                Für {b.name} ansehen
              </a>
            </li>
          ))
        }
      </ul>

      <div class="zuschnitt">
        <p>
          <strong>Deine Branche ist nicht dabei? Macht nichts.</strong>
          {" "}Werkstatt, Praxis, Fahrschule, Metzgerei, Fotograf, Steuerbüro:
          Ich baue für jede Branche. Die Fragen sind überall dieselben, nur die
          Antworten sind andere.
        </p>
        <p>
          <strong>Worauf es mir ankommt: Es muss ein Einzelbetrieb sein.</strong>
          {" "}Ein Standort, ein Inhaber, jemand, der selbst ans Telefon geht.
          Bei Ketten mit mehreren Filialen entscheidet die Zentrale, und da bin
          ich der Falsche.
        </p>
        <p class="zuschnitt__nein">
          <strong>Was ich nicht baue:</strong> Onlineshops, Auftritte für
          Konzerne, und Zulieferarbeit für Agenturen. Trifft eines davon auf
          dich zu, sage ich dir das im ersten Telefonat, statt dir etwas zu
          verkaufen.
        </p>
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="breite">
      <h2>Was ich mache</h2>
      <ul class="kacheln kacheln--3">
        {
          leistungen.map((l) => (
            <li class="kachel">
              <h3>{l.name}</h3>
              <p>{l.kurz}</p>
              <a class="kachel__mehr" href={`/leistungen/${l.slug}`}>
                Mehr dazu
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="abschnitt band--karte">
    <div class="breite">
      <h2>Preise, die vorher feststehen</h2>
      <p class="vorspann">
        Drei Pakete, und der Preis hängt allein an der Seitenzahl. Auf der
        Preisseite siehst du deinen Betrag sofort.
      </p>

      <ul class="preise">
        {
          pakete.map((p) => (
            <li class:list={["preis", p.hervorgehoben && "preis--wahl"]}>
              <span class="preis__name">{p.name}</span>
              <span class="preis__betrag">ab {euro(p.preisAb)}</span>
              <span class="preis__zusatz">
                {p.seitenMin}–{p.seitenMax} Seiten · {euro(p.pflegeMonat)} im
                Monat
              </span>
            </li>
          ))
        }
      </ul>

      <p class="leise">{umsatzsteuerHinweis}. Der angezeigte Preis ist der Preis.</p>
      <p>
        <a class="knopf" href="/preise">Preise vergleichen</a>
      </p>
    </div>
  </section>

  <section class="abschnitt">
    <div class="breite">
      <h2>Beispiele</h2>
      {zeigeKonzepthinweis && <p>{hinweisKonzeptprojekte}</p>}

      <ul class="kacheln kacheln--3">
        {
          projekte.map((p) => (
            <li class="kachel">
              {kennzeichnung(p) && (
                <p class="kachel__marke">{kennzeichnung(p)}</p>
              )}
              <h3>{p.name}</h3>
              <p>{p.kurz}</p>
              <a class="kachel__mehr" href={`/arbeiten/${p.slug}`}>
                Projekt ansehen
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Kontaktabschluss />
</Basis>

<style>
  .knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: var(--raum-2);
    margin-bottom: var(--raum-3);
  }

  /* Fahrplan ------------------------------------------------------------- */
  /* Vorher stand hier eine Aufzählung mit Randlinie, also Fließtext in drei
     Teilen. Jetzt eine Schiene mit nummerierten Halten und daneben das Handy
     mit der Vorschauadresse. Ohne Bewegung: PROJEKT.md verbietet
     Einblende-Animationen beim Scrollen. */

  .fahrplan {
    display: grid;
    gap: var(--raum-4);
    margin: var(--raum-4) 0;
  }

  @media (min-width: 62rem) {
    .fahrplan {
      grid-template-columns: minmax(0, 1fr) 17rem;
      align-items: start;
      gap: var(--raum-6);
    }
  }

  .zeitplan {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 40rem;
  }

  .halt {
    position: relative;
    padding-left: 3.5rem;
    padding-bottom: var(--raum-4);
  }

  .halt:last-child {
    padding-bottom: 0;
  }

  /* Die Schiene zwischen zwei Halten. Beim offenen Schritt gestrichelt,
     weil dort niemand eine Dauer versprechen kann. */
  .halt::before {
    content: "";
    position: absolute;
    left: 1.1875rem;
    top: 2.75rem;
    bottom: 0;
    border-left: 2px solid var(--eisblau);
  }

  .halt:last-child::before {
    display: none;
  }

  .halt--offen::before {
    border-left-style: dashed;
  }

  .halt__marke {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 2px solid var(--stahl);
    border-radius: var(--radius);
    background: var(--stahl);
    color: var(--auf-tinte);
    font-family: var(--schrift-titel);
    font-size: 1.25rem;
    font-weight: 600;
  }

  /* Der Schritt, der bei Tom nicht liegt, ist auch optisch nicht gefüllt. */
  .halt__marke--offen {
    background: transparent;
    color: var(--stahl);
  }

  .halt__dauer {
    display: block;
    margin-bottom: 0.125rem;
    font-size: var(--gr-klein);
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--stahl);
  }

  .halt__dauer--offen {
    color: color-mix(in srgb, var(--tinte) 65%, var(--papier));
  }

  .halt__titel {
    margin: 0 0 var(--raum-1);
  }

  .halt__text {
    margin: 0;
    color: color-mix(in srgb, var(--tinte) 82%, var(--papier));
  }

  /* Handy ---------------------------------------------------------------- */
  /* Schematisch, kein Bildschirmfoto: Balken statt Text, damit niemand ein
     Kundenprojekt hineinliest. Die Maße darin sind kleiner als --raum-1 und
     stehen deshalb bewusst als eigene, kleine Staffel hier unten. */

  /* Am Telefon steht das Handy neben seiner Bildunterschrift. Untereinander
     kostet es dort 300 Pixel, und die Startseite liegt ohnehin nah an der
     Vellox-Grenze von zwölf Bildschirmen. */
  .vorschau {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    align-items: center;
    gap: var(--raum-3);
    margin: 0;
  }

  @media (min-width: 62rem) {
    .vorschau {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: var(--raum-2);
    }
  }

  .handy {
    --geraet: 1.25rem; /* Geräteecken, runder als --radius. Ein Handy hat keine 4-px-Ecken. */
    display: flex;
    flex-direction: column;
    aspect-ratio: 10 / 19;
    max-width: 15rem;
    border: 0.375rem solid var(--tinte);
    border-radius: var(--geraet);
    background: var(--karte);
    overflow: hidden;
  }

  @media (min-width: 62rem) {
    .handy {
      border-width: 0.5rem;
    }
  }

  .handy__leiste {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.375rem 0.25rem;
    background: var(--papier);
    border-bottom: 1px solid var(--eisblau);
    font-size: 0.5rem;
    white-space: nowrap;
    color: color-mix(in srgb, var(--tinte) 70%, var(--papier));
  }

  @media (min-width: 62rem) {
    .handy__leiste {
      font-size: 0.5625rem;
    }
  }

  .handy__schloss {
    flex: none;
    fill: currentColor;
  }

  .handy__kopf {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.625rem;
    background: var(--tinte);
  }

  .handy__marke {
    width: 2.5rem;
    height: 0.375rem;
    background: var(--auf-tinte);
  }

  .handy__menue {
    display: grid;
    gap: 0.1875rem;
  }

  .handy__menue span {
    display: block;
    width: 0.75rem;
    height: 0.125rem;
    background: var(--auf-tinte);
  }

  .handy__inhalt {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    flex: 1;
    padding: 0.75rem 0.625rem;
  }

  .bl {
    display: block;
    height: 0.375rem;
    background: var(--eisblau);
  }

  .bl--titel {
    height: 0.6875rem;
    background: color-mix(in srgb, var(--tinte) 55%, var(--karte));
  }

  .bl--kurz {
    width: 65%;
  }

  .handy__knopf {
    display: block;
    margin-top: 0.375rem;
    padding: 0.375rem;
    border-radius: var(--radius);
    background: var(--stahl);
    color: var(--auf-tinte);
    font-family: var(--schrift-titel);
    font-size: 0.5625rem;
    font-weight: 600;
    text-align: center;
  }

  .handy__zeiten {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.375rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--eisblau);
    font-size: 0.5rem;
  }

  .handy__zeit {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    color: color-mix(in srgb, var(--tinte) 75%, var(--karte));
  }

  .vorschau figcaption {
    max-width: 24rem;
    margin: 0;
    font-size: var(--gr-klein);
    color: color-mix(in srgb, var(--tinte) 75%, var(--papier));
  }

  /* Wofür ich nicht der Richtige bin. Vellox: Jede Seite, die verkauft, sagt
     an mindestens einer Stelle, für wen sie nicht gemacht ist. */
  .fazit {
    margin-top: var(--raum-4);
    margin-bottom: 0;
    font-size: var(--gr-gross);
    font-weight: 600;
  }

  /* Preisübersicht: knapp, die eigentliche Tabelle steht auf /preise. */
  .preise {
    display: grid;
    gap: 0;
    margin: 0 0 var(--raum-3);
    padding: 0;
    list-style: none;
    max-width: 44rem;
    border: 2px solid var(--eisblau);
    border-radius: var(--radius);
    background: var(--karte);
  }

  .preis {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 var(--raum-2);
    padding: var(--raum-3);
    border-bottom: 1px solid var(--eisblau);
  }

  .preis:last-child {
    border-bottom: 0;
  }

  .preis--wahl {
    border-left: 4px solid var(--stahl);
  }

  .preis__name {
    font-family: var(--schrift-titel);
    font-size: var(--gr-h3);
    font-weight: 600;
  }

  .preis__betrag {
    font-family: var(--schrift-titel);
    font-size: var(--gr-h3);
    font-weight: 600;
    text-align: right;
  }

  .preis__zusatz {
    grid-column: 1 / -1;
    margin-top: 0.25rem;
    font-size: var(--gr-klein);
    color: color-mix(in srgb, var(--tinte) 70%, var(--karte));
  }
</style>
