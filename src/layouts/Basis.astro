---
/**
 * Grundgerüst jeder Seite: Kopf, Inhalt, Fuß.
 *
 * Titel und Beschreibung kommen von der jeweiligen Seite, damit sie nie
 * doppelt sind. Dazu die Angaben, die auf jede Seite gehören: Canonical,
 * Sprache und die strukturierten Daten zum Betrieb.
 */
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/public-sans";
import "../styles/global.css";

/**
 * Die beiden Schriftdateien werden vorab geladen.
 *
 * Ohne das erscheint der Text zuerst in der Systemschrift und springt beim
 * Nachladen um, gemessen 0,38 an Layout-Sprüngen, erlaubt sind 0,1. Mit dem
 * Vorabladen sind die Schriften da, bevor der Text zum ersten Mal erscheint.
 */
import schriftTitel from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import schriftText from "@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url";

import Kopfbereich from "../components/Kopfbereich.astro";
import Fussbereich from "../components/Fussbereich.astro";
import { brand, mailFehlt } from "../config/brand";
import { inDieSucheAufnehmen } from "../config/veroeffentlichung";
import { pakete, euro } from "../data/pakete";

interface Props {
  titel: string;
  beschreibung: string;
  /** Seiten, die nicht in die Suche gehören: /danke und 404. */
  noindex?: boolean;
}

const { titel, beschreibung, noindex = false } = Astro.props;

/**
 * Zwei Gründe halten eine Seite aus der Suche: Die Seite selbst sagt es, oder
 * die ganze Website steht noch auf unsichtbar. Siehe veroeffentlichung.ts.
 */
const ausDerSuche = noindex || !inDieSucheAufnehmen;

/** Eine eindeutige Adresse je Seite, damit Google keine Doppel sieht. */
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/** Das Bild für geteilte Verknüpfungen. Muss absolut sein, relative Pfade
    werden von WhatsApp und Facebook nicht aufgelöst. */
const teilbild = new URL("/teilbild.png", Astro.site).href;

/**
 * Strukturierte Daten zum Betrieb, auf jeder Seite.
 * Die Anschrift fehlt bewusst, sie steht noch nicht fest, und eine erfundene
 * Adresse wäre schlimmer als gar keine.
 */
const betrieb = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: brand.name,
  url: brand.domain,
  telephone: brand.telefonE164,
  // Erst eintragen, wenn es eine echte Adresse gibt. Eine erfundene in den
  // strukturierten Daten ist schlimmer als ein fehlendes Feld.
  ...(mailFehlt ? {} : { email: brand.mail }),
  areaServed: { "@type": "AdministrativeArea", name: brand.region },
  founder: { "@type": "Person", name: brand.inhaber },
  knowsLanguage: "de",
  // Spanne statt einzelner Zahl, damit sie stimmt, egal welches Paket.
  priceRange: `${euro(pakete[0].preisAb)} bis ${euro(pakete[pakete.length - 1].preisAb)}`,
  image: new URL("/teilbild.png", Astro.site).href,
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={schriftText}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={schriftTitel}
      crossorigin
    />

    <title>{titel} – {brand.name}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={canonical} />
    {ausDerSuche && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Die Farbe der Adressleiste auf dem Handy. Muss die Farbe sein, die
        oben auf der Seite steht, sonst sitzt ein dunkler Streifen ueber
        einer hellen Seite. Haendisch gepflegt, weil <meta> keine
        CSS-Variablen kennt: siehe --papier in global.css. */}
    <meta name="theme-color" content="#dfe6ed" />

    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${titel} – ${brand.name}`} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={brand.name} />

    {/* Ohne Bild erscheint eine geteilte Verknüpfung in WhatsApp als nackter
        grauer Kasten. Genau so schicken sich Handwerker und Gastronomen
        gegenseitig Kontakte weiter. Das Bild entsteht beim Bau, siehe
        scripts/make-teilbild.mjs. */}
    <meta property="og:image" content={teilbild} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${brand.name}, Websites für kleine Betriebe`}
    />
    <meta name="twitter:card" content="summary_large_image" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(betrieb)}
      is:inline
    />

    {/* Ohne JavaScript gibt es niemanden, der den Menüknopf bedienen könnte.
        Dann verschwindet der Knopf und die Navigation steht offen da. Die
        Seite ist untereinander bedienbar, aber nie kaputt. Steht hier und
        nicht in Kopfbereich.astro, weil Astro Stile in Komponenten auf die
        Komponente einschränkt und diese Regeln global gelten müssen. */}
    <noscript>
      <style>
        .kopf__menue { display: none !important; }
        @media (max-width: 59.999em) {
          .kopf__navigation { display: flex !important; }
        }
      </style>
    </noscript>
  </head>

  <body>
    <a class="sprung" href="#inhalt">Zum Inhalt springen</a>
    <Kopfbereich />
    <main id="inhalt">
      <slot />
    </main>
    <Fussbereich />

    {/* Aktionsleiste am unteren Rand, nur auf dem Handy.

        Grund: Die Startseite ist über zehn Bildschirme hoch. Handlungsaufrufe
        gab es auf Bildschirm 1 und danach erst wieder im Kontaktabschluss.
        Zehn Bildschirme lang liest jemand, warum seine Seite nicht
        funktioniert, wird überzeugt, und findet nichts zum Drücken.

        Das ist kein Chat-Widget, kein Aufklapper und kein Newsletter-Fenster.
        Alle drei verbietet PROJEKT.md, und aus gutem Grund: Sie verdecken und
        unterbrechen. Diese Leiste tut beides nicht, sie steht auf jeder Seite
        an derselben Stelle und verlangt nichts. */}
    <div class="daumenleiste">
      <a class="knopf" href={`tel:${brand.telefonE164}`}>Anrufen</a>
      <a class="knopf knopf--rand" href="/kontakt">
        Schreiben<span class="nur-vorlesen"> und Anfrage schicken</span>
      </a>
    </div>
  </body>
</html>
