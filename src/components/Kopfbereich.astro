---
/**
 * Kopfbereich mit Hauptnavigation.
 *
 * Genau fünf Punkte plus Kontakt-Knopf. Auf schmalen Bildschirmen klappt die
 * Liste über einen Knopf auf. Ohne JavaScript bleibt die Liste sichtbar.
 * Die Seite ist dann untereinander bedienbar, aber nie kaputt.
 *
 * Links davor der Zurück-Pfeil. Er steht auf jeder Seite außer der
 * Startseite, und weil er hier steht und nicht in den einzelnen Seiten, kann
 * ihn keine neue Seite vergessen.
 */
import Logo from "./Logo.astro";
import {
  hauptnavigation,
  kontaktKnopf,
  uebergeordnet,
} from "../config/navigation";

const pfad = Astro.url.pathname.replace(/\/+$/, "") || "/";

/** Ziel und Beschriftung, solange kein JavaScript läuft. */
const zurueck = uebergeordnet(pfad);

function istAktiv(ziel: string) {
  return pfad === ziel || pfad.startsWith(ziel + "/");
}
---

<header class="kopf">
  <div class="breite kopf__innen">
    <div class="kopf__links">

      {/* GEPRÜFT UND VERWORFEN: Platz für den Pfeil auch auf der Startseite
          reservieren, damit das Logo beim ersten Klick nicht um 120 Pixel
          nach rechts rutscht. Sieht in der Umsetzung schlechter aus als das
          Problem: Auf der wichtigsten Seite der Website steht das Logo dann
          eingerückt vor einer leeren Fläche, und das liest sich als Fehler.

          Der Versatz ist außerdem kein Layout-Sprung im technischen Sinn.
          Er passiert zwischen zwei Seitenaufrufen, nicht während einer
          Seite, und dass beim Verlassen der Startseite ein Zurück-Pfeil
          erscheint, ist genau die Information, die er tragen soll. */}
      {
        zurueck && (
          <a
            class="zurueck"
            href={zurueck.pfad}
            aria-label={`Zurück zu ${zurueck.text}`}
            data-zurueck
          >
            <svg
              class="zurueck__pfeil"
              viewBox="0 0 16 16"
              width="16"
              height="16"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M9.75 3 4.75 8l5 5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              />
            </svg>
            <span data-zurueck-text>
              <span class="zurueck__kurz">Zurück</span>
              <span class="zurueck__lang">{zurueck.text}</span>
            </span>
          </a>
        )
      }

      <a class="kopf__marke" href="/" aria-label="Zur Startseite">
        <Logo />
      </a>
    </div>

    <button
      class="kopf__menue"
      type="button"
      aria-expanded="false"
      aria-controls="hauptmenue"
    >
      Menü
    </button>

    <div class="kopf__navigation" id="hauptmenue">
      <nav aria-label="Hauptnavigation">
        <ul class="kopf__liste">
          {
            hauptnavigation.map((punkt) => (
              <li>
                <a
                  href={punkt.pfad}
                  aria-current={istAktiv(punkt.pfad) ? "page" : undefined}
                >
                  {punkt.text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a class="knopf" href={kontaktKnopf.pfad}>{kontaktKnopf.text}</a>
    </div>
  </div>
</header>


<script>
  const knopf = document.querySelector<HTMLButtonElement>(".kopf__menue");
  const menue = document.getElementById("hauptmenue");

  if (knopf && menue) {
    /**
     * Der Ausgangszustand kommt aus dem CSS, nicht von hier.
     *
     * Vorher lieferte der Kopfbereich die Navigation ausgeklappt aus und
     * klappte sie erst per JavaScript zu. Astro kompiliert dieses Skript zu
     * type="module", und Modulskripte laufen erst nach dem Parsen. Auf dem
     * Handy erschien also zuerst die volle Liste, rund 340 Pixel hoch, dann
     * klappte sie zu und die ganze Seite sprang nach oben. Gemessen als
     * Layout-Sprung im Bereich 0,4, erlaubt sind 0,1.
     *
     * Jetzt entscheidet CSS: zu ist der Normalfall, offen braucht
     * data-offen. Ohne JavaScript blendet ein noscript-Block den Knopf aus
     * und die Liste ein. Kein Sprung in beiden Fällen.
     */
    const umschalten = (offen: boolean) => {
      knopf.setAttribute("aria-expanded", String(offen));
      if (offen) menue.setAttribute("data-offen", "");
      else menue.removeAttribute("data-offen");
    };

    knopf.addEventListener("click", () => {
      umschalten(knopf.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && knopf.getAttribute("aria-expanded") === "true") {
        umschalten(false);
        knopf.focus();
      }
    });
  }

  /**
   * Der Zurück-Pfeil.
   *
   * Im Markup steht er als gewöhnlicher Verweis eine Ebene höher. Er
   * funktioniert also auch ohne JavaScript und führt immer irgendwohin.
   *
   * Kam der Besucher von einer Seite dieser Website, ist die Ebene darüber
   * aber nicht das, was er erwartet. Dann heißt der Pfeil "Zurück" und
   * bringt ihn genau dorthin, wo er hergekommen ist.
   */
  const zurueck = document.querySelector<HTMLAnchorElement>("[data-zurueck]");

  if (zurueck) {
    let vonDieserSeite = false;
    try {
      vonDieserSeite =
        document.referrer !== "" &&
        new URL(document.referrer).origin === location.origin;
    } catch {
      vonDieserSeite = false;
    }

    if (vonDieserSeite && history.length > 1) {
      const beschriftung = zurueck.querySelector("[data-zurueck-text]");
      if (beschriftung) beschriftung.textContent = "Zurück";
      zurueck.setAttribute("aria-label", "Zurück zur vorherigen Seite");

      zurueck.addEventListener("click", (e) => {
        // Nicht bei Mittelklick oder gedrückter Taste: Wer in einem neuen
        // Tab öffnen will, soll das Ziel aus dem href bekommen.
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) {
          return;
        }
        e.preventDefault();
        history.back();
      });
    }
  }
</script>

<style>
  .kopf {
    background: var(--papier);
    border-bottom: var(--linie);
  }

  .kopf__innen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--raum-2);
    padding-block: var(--raum-2);
  }

  .kopf__links {
    display: flex;
    align-items: center;
    gap: var(--raum-2);
  }

  .kopf__marke {
    text-decoration: none;
    color: inherit;
  }

  /* Zurück-Pfeil ---------------------------------------------------------- */

  .zurueck {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    /* 44 Pixel hoch, damit der Daumen ihn trifft. */
    min-height: 2.75rem;
    padding-right: var(--raum-2);
    border-right: var(--linie);
    color: var(--stahl);
    font-size: var(--gr-klein);
    font-weight: 600;
    text-decoration: none;
  }

  .zurueck:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .zurueck__pfeil {
    flex: none;
  }

  /* Am Telefon steht nur "Zurück". Das längste Ziel heißt "Häufige
     Probleme", und damit passen Pfeil, Marke und Menüknopf nicht mehr in
     eine Zeile. Sobald Platz ist, steht das Ziel beim Namen, dann stimmt die
     Beschriftung auch ohne JavaScript genau mit dem Verweis überein. */
  .zurueck__lang {
    display: none;
  }

  @media (min-width: 30em) {
    .zurueck__kurz {
      display: none;
    }

    .zurueck__lang {
      display: inline;
    }
  }

  .kopf__menue {
    min-height: 2.75rem;
    padding: 0.5rem var(--raum-2);
    border: 2px solid var(--stahl);
    border-radius: var(--radius);
    background: transparent;
    color: var(--stahl);
    font-family: var(--schrift-text);
    font-size: var(--gr-text);
    font-weight: 600;
    cursor: pointer;
  }

  .kopf__menue[hidden] {
    display: none;
  }

  /* Auf schmalen Bildschirmen ist die Liste zu, bis data-offen gesetzt wird.
     Das entscheidet CSS und nicht JavaScript, siehe Kommentar im Skript. */
  .kopf__navigation {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--raum-3);
    width: 100%;
    padding-block: var(--raum-2) var(--raum-1);
  }

  .kopf__navigation[data-offen] {
    display: flex;
  }

  .kopf__liste {
    display: flex;
    flex-direction: column;
    gap: var(--raum-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kopf__liste a {
    display: inline-block;
    padding-block: 0.25rem;
    color: var(--tinte);
    font-weight: 500;
    text-decoration: none;
  }

  .kopf__liste a:hover {
    color: var(--stahl);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  /* Die Seite, auf der man gerade ist. */
  .kopf__liste a[aria-current="page"] {
    color: var(--stahl);
    border-bottom: 2px solid var(--stahl);
  }

  @media (min-width: 60em) {
    .kopf__menue {
      display: none;
    }

    .kopf__navigation,
    .kopf__navigation[data-offen] {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: flex-end;
      gap: var(--raum-4);
      width: auto;
      padding-block: 0;
    }

    .kopf__liste {
      flex-direction: row;
      gap: var(--raum-4);
    }
  }
</style>
