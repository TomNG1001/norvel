{
  "name": "website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/make-favicon.mjs",
    "dev": "astro dev --port 3491",
    "prebuild": "node scripts/make-favicon.mjs && npm run check:sprache",
    "build": "npm run check:brand && astro build",
    "postbuild": "npm run check:schablone && npm run check:vorspann",
    "preview": "astro preview --port 3491",
    "check:brand": "node scripts/check-brand.mjs",
    "check:sprache": "node scripts/check-sprache.mjs",
    "check:schablone": "node scripts/check-schablone.mjs",
    "favicon": "node scripts/make-favicon.mjs",
    "check:vorspann": "node scripts/check-vorspann.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "astro": "^7.2.0"
  }
}
